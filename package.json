{
  "name": "browser-query-utils",
  "description": "Lightweight, safe helpers for getting, setting, and deleting URL query parameters in browsers.",
  "version": "2.0.1",
  "type": "module",
	"main": "dist/browser-query-utils.cjs.min.js",
	"module": "dist/browser-query-utils.min.js",
	"exports": {
		".": {
			"import": "./dist/browser-query-utils.min.js",
			"require": "./dist/browser-query-utils.cjs.min.js"
		}
	},
	"files": [
		"dist/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/**/*.js",
    "build": "node build.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samiahmedsiddiqui/browser-query-utils.git"
  },
  "keywords": [
    "cookie",
    "browser",
    "utils"
  ],
  "author": "Sami Ahmed Siddiqui <samiahmedsiddiqui91@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samiahmedsiddiqui/browser-query-utils/issues"
  },
  "homepage": "https://github.com/samiahmedsiddiqui/browser-query-utils#readme",
  "devDependencies": {
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "prettier": "3.7.4",
    "terser": "5.44.1"
  }
}
